{
  "name": "@se-2/hardhat",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "account": "hardhat run --no-compile scripts/listAccount.ts",
    "account:generate": "hardhat run --no-compile scripts/generateAccount.ts",
    "account:import": "hardhat run --no-compile scripts/importAccount.ts",
    "account:reveal-pk": "hardhat run --no-compile scripts/revealPK.ts",
    "chain": "hardhat node --network hardhat",
    "check-types": "tsc --noEmit --incremental",
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "deploy": "hardhat compile && tsx scripts/runHardhatDeployWithPK.ts",
    "flatten": "hardhat flatten",
    "fork": "MAINNET_FORKING_ENABLED=true hardhat node --network hardhat",
    "format": "prettier --write './**/*.(ts|sol)'",
    "generate": "yarn account:generate",
    "hardhat-verify": "hardhat verify",
    "lint": "eslint",
    "lint-staged": "eslint",
    "test": "hardhat test --network hardhat --gas-stats",
    "verify": "tsx scripts/runVerify.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.1",
    "@nomicfoundation/hardhat-mocha": "^4.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "^3.1.2",
    "@nomicfoundation/ignition-core": "^3.1.10",
    "@rocketh/deploy": "^0.20.1",
    "@rocketh/node": "^0.21.4",
    "@rocketh/read-execute": "^0.21.1",
    "@rocketh/signer": "^0.19.19",
    "@rocketh/verifier": "^0.19.28",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "chai": "^6.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "ethers": "^6.17.0",
    "globals": "^17.13.0",
    "hardhat": "^3.18.1",
    "hardhat-deploy": "^2.0.30",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "prettier-plugin-solidity": "^2.4.1",
    "rocketh": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@inquirer/password": "^5.2.3",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^18.0.5",
    "envfile": "^7.1.0",
    "qrcode": "^1.5.4"
  }
}
